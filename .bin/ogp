#!/bin/sh
# ogp - queue a URL for batch OGP fetching (the fetch itself is ogp-batch).
#
# Called by altd: GET https://a.ze.gs/ogp/<encodeURIComponent(url)>
# altd splits the request path on '/' first and decodeURIComponent's each
# segment, so the URL arrives as exactly one argument ($1), however many
# '?' or '&' it contains. Deliberately append-only and near-instant;
# ogp-batch re-validates (including SSRF checks) before fetching.
set -eu

url=${1:-}
case "$url" in
  http://*|https://*) ;;
  *) exit 0 ;;
esac
# altd itself drops decoded arguments longer than 1024 chars; keep the
# same bound here so direct invocations behave identically.
[ "${#url}" -le 1024 ] || exit 0

dir="${OGP_HOME:-$HOME/.ogp}"
mkdir -p "$dir"
# Short O_APPEND writes are atomic; no locking needed against ogp-batch,
# which rotates the queue with a rename before reading it.
printf '%s\t%s\n' "$(date +%s)" "$url" >> "$dir/queue.tsv"

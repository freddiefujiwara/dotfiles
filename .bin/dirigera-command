#!/usr/bin/env python3
"""dirigera-command: operate IKEA DIRIGERA lights from the shell.

Usage:
  dirigera-command list
  dirigera-command on  <name|group|all>
  dirigera-command off <name|group|all>
  dirigera-command level <name|group|all> <1-100>

Groups (fixed sets of lights; keys are matched case-insensitively):
  dining    Dining 01, Dining 02, Dining 03, Dining 04, Dining 05
  down      Down light 01, Down light 02
  kitchen   Kitchen 01, Kitchen 02
  kids      Light 3, Light 4
  bathroom  Bathroom 01, Bathroom 02
  corridor  Corridor 01, Corridor 02
  downback  Downlight 03
  washroom  Washroom
  restroom  Restroom

Config (kept outside this script):
  ~/.dirigera-token  bearer token (mode 600)
  ~/.dirigera-ip     hub IP address
"""
import os
import sys

import dirigera

GROUPS = {
    "dining": ["Dining 01", "Dining 02", "Dining 03", "Dining 04", "Dining 05"],
    "down": ["Down light 01", "Down light 02"],
    "kitchen": ["Kitchen 01", "Kitchen 02"],
    "kids": ["Light 3", "Light 4"],
    "bathroom": ["Bathroom 01", "Bathroom 02"],
    "corridor": ["Corridor 01", "Corridor 02"],
    "downback": ["Downlight 03"],
    "washroom": ["Washroom"],
    "restroom": ["Restroom"],
}


def load_hub():
    with open(os.path.expanduser("~/.dirigera-token")) as f:
        token = f.read().strip()
    with open(os.path.expanduser("~/.dirigera-ip")) as f:
        ip = f.read().strip()
    return dirigera.Hub(token, ip)


def pick(lights, target):
    if target.lower() == "all":
        return lights
    by_name = {light.attributes.custom_name.lower(): light for light in lights}
    key = target.lower()
    if key in GROUPS:
        missing = [name for name in GROUPS[key] if name.lower() not in by_name]
        if missing:
            print(f"error: group '{key}' is missing lights: {', '.join(missing)}", file=sys.stderr)
            sys.exit(2)
        return [by_name[name.lower()] for name in GROUPS[key]]
    if key in by_name:
        return [by_name[key]]
    names = ", ".join(sorted(light.attributes.custom_name for light in lights))
    groups = ", ".join(sorted(GROUPS))
    print(f"error: no light named '{target}'\navailable: {names}\ngroups: {groups}", file=sys.stderr)
    sys.exit(2)


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 2
    cmd = argv[1]
    hub = load_hub()
    lights = hub.get_lights()
    if cmd == "list" and len(argv) == 2:
        for light in sorted(lights, key=lambda x: (x.room.name, x.attributes.custom_name)):
            state = "on " if light.attributes.is_on else "off"
            print(f"{light.attributes.custom_name}\t{light.room.name}\t{state}\t{light.attributes.light_level}")
        return 0
    if cmd in ("on", "off") and len(argv) == 3:
        for light in pick(lights, argv[2]):
            light.set_light(cmd == "on")
            print(f"{cmd}: {light.attributes.custom_name}")
        return 0
    if cmd == "level" and len(argv) == 4:
        try:
            level = int(argv[3])
        except ValueError:
            print("error: level must be 1-100", file=sys.stderr)
            return 2
        if not 1 <= level <= 100:
            print("error: level must be 1-100", file=sys.stderr)
            return 2
        for light in pick(lights, argv[2]):
            light.set_light_level(level)
            print(f"level {level}: {light.attributes.custom_name}")
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
